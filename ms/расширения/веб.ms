# Расширение «Веб»: полный каркас для HTML-сайтов на MS
# Подключение: подключить("веб")
# Всё, что нужно: теги, компоненты, меню, формы, готовая тема и сборка сайта.

# ---------- ядро ----------

делать экранировать(т):
    пусть р = заменить("" + т, "&", "&amp;")
    р = заменить(р, "<", "&lt;")
    р = заменить(р, ">", "&gt;")
    р = заменить(р, "\"", "&quot;")
    р = заменить(р, "'", "&#39;")
    вернуть р

делать атрибуты(сл):
    пусть итог = ""
    для к в словарь_ключи(сл):
        пусть з = словарь_получить(сл, к)
        если з == правда:
            итог = итог + " " + к
        иначе:
            итог = итог + " " + к + "=\"" + экранировать(з) + "\""
    вернуть итог

делать тег(имя, содержимое):
    вернуть "<" + имя + ">" + содержимое + "</" + имя + ">"

делать тег_а(имя, атр, содержимое):
    вернуть "<" + имя + атрибуты(атр) + ">" + содержимое + "</" + имя + ">"

делать одиночный(имя, атр):
    вернуть "<" + имя + атрибуты(атр) + ">"

# ---------- элементы ----------

делать заголовок(уровень, текст):
    вернуть "<h" + уровень + ">" + экранировать(текст) + "</h" + уровень + ">"

делать абзац(т):
    вернуть "<p>" + экранировать(т) + "</p>"

делать цитата(т):
    вернуть "<blockquote>" + экранировать(т) + "</blockquote>"

делать код_блок(т):
    вернуть "<code>" + экранировать(т) + "</code>"

делать выделить(т):
    вернуть "<strong>" + экранировать(т) + "</strong>"

делать курсив(т):
    вернуть "<em>" + экранировать(т) + "</em>"

делать ссылка(текст, адрес):
    вернуть тег_а("a", словарь("href", адрес), экранировать(текст))

делать картинка(адрес, подпись):
    вернуть одиночный("img", словарь("src", адрес, "alt", подпись, "loading", "lazy"))

делать кнопка(текст, адрес):
    вернуть тег_а("a", словарь("href", адрес, "class", "btn"), экранировать(текст))

делать разделитель():
    вернуть "<hr>"

делать список(элементы):
    пусть итог = "<ul>"
    для э в элементы:
        итог = итог + "<li>" + экранировать(э) + "</li>"
    вернуть итог + "</ul>"

делать список_н(элементы):
    пусть итог = "<ol>"
    для э в элементы:
        итог = итог + "<li>" + экранировать(э) + "</li>"
    вернуть итог + "</ol>"

делать таблица(шапка, строки):
    пусть итог = "<table>"
    если длина(шапка) > 0:
        итог = итог + "<thead><tr>"
        для я в шапка:
            итог = итог + "<th>" + экранировать(я) + "</th>"
        итог = итог + "</tr></thead>"
    итог = итог + "<tbody>"
    для стр в строки:
        итог = итог + "<tr>"
        для я в стр:
            итог = итог + "<td>" + экранировать(я) + "</td>"
        итог = итог + "</tr>"
    вернуть итог + "</tbody></table>"

делать карточка(заголовок_стр, тело):
    пусть ш = "<div class=\"card\"><h3>" + экранировать(заголовок_стр) + "</h3>"
    вернуть ш + "<div class=\"card-body\">" + тело + "</div></div>"

делать карточки(элементы):
    пусть итог = "<div class=\"cards\">"
    для э в элементы:
        итог = итог + карточка(словарь_получить(э, "заголовок"), словарь_получить(э, "тело"))
    вернуть итог + "</div>"

делать секция(содержимое, класс):
    пусть имя = "section"
    если длина(класс) > 0:
        имя = "section " + класс
    вернуть "<div class=\"" + имя + "\">" + содержимое + "</div>"

делать поле(имя, подпись, тип):
    пусть вид = "text"
    если длина(тип) > 0:
        вид = тип
    пусть ш = "<label class=\"field\"><span>" + экранировать(подпись) + "</span>"
    ш = ш + "<input type=\"" + экранировать(вид) + "\" name=\"" + экранировать(имя) + "\">"
    вернуть ш + "</label>"

делать форма(поля, действие, текст_кнопки):
    пусть ш = "<form class=\"form\" method=\"post\" action=\"" + экранировать(действие) + "\">"
    для п в поля:
        ш = ш + поле(словарь_получить(п, "имя"), словарь_получить(п, "подпись"), словарь_получить(п, "тип"))
    вернуть ш + "<button type=\"submit\">" + экранировать(текст_кнопки) + "</button></form>"

делать меню(пункты):
    пусть ш = "<nav class=\"nav\">"
    для п в пункты:
        ш = ш + "<a href=\"" + экранировать(словарь_получить(п, "адрес")) + "\">" + экранировать(словарь_получить(п, "текст")) + "</a>"
    вернуть ш + "</nav>"

делать шапка(название, пункты):
    пусть ш = "<header class=\"head\"><a class=\"brand\" href=\"index.html\">" + экранировать(название) + "</a>"
    если длина(пункты) > 0:
        ш = ш + меню(пункты)
    вернуть ш + "</header>"

делать подвал(текст):
    вернуть "<footer class=\"foot\">" + экранировать(текст) + "</footer>"

делать две_колонки(лево, право):
    вернуть "<div class=\"cols\"><div>" + лево + "</div><div>" + право + "</div></div>"

# ---------- тема ----------

делать стили():
    пусть ш = ":root{--ink:#222;--muted:#667;--line:#e2e4e4;--bg:#fff;--tint:#f6f7f7}"
    ш = ш + "\n*{box-sizing:border-box}"
    ш = ш + "\nbody{margin:0;font:16px/1.6 system-ui,Segoe UI,Arial,sans-serif;color:var(--ink);background:var(--bg)}"
    ш = ш + "\na{color:#0b5cad;text-decoration:none}a:hover{text-decoration:underline}"
    ш = ш + "\n.head{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:18px 24px;border-bottom:1px solid var(--line);max-width:1000px;margin:0 auto}"
    ш = ш + "\n.brand{font-weight:800;font-size:19px;color:var(--ink)}"
    ш = ш + "\n.nav{display:flex;gap:18px;flex-wrap:wrap}"
    ш = ш + "\n.section{max-width:1000px;margin:0 auto;padding:32px 24px}"
    ш = ш + "\n.section.narrow{max-width:720px}"
    ш = ш + "\nh1{font-size:34px;line-height:1.2;margin:0 0 16px}h2{margin-top:32px}h3{margin:0 0 8px}"
    ш = ш + "\np{margin:0 0 14px}"
    ш = ш + "\nblockquote{margin:0 0 14px;padding:12px 18px;border-left:3px solid var(--line);color:var(--muted)}"
    ш = ш + "\ncode{background:var(--tint);padding:2px 6px;border-radius:5px;font-size:14px}"
    ш = ш + "\npre{background:var(--tint);padding:16px;border-radius:10px;overflow:auto}"
    ш = ш + "\nhr{border:0;border-top:1px solid var(--line);margin:28px 0}"
    ш = ш + "\ntable{width:100%;border-collapse:collapse;margin:0 0 18px}"
    ш = ш + "\nth,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:top}"
    ш = ш + "\nth{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--tint)}"
    ш = ш + "\n.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin:0 0 18px}"
    ш = ш + "\n.card{border:1px solid var(--line);border-radius:12px;padding:18px;background:var(--bg)}"
    ш = ш + "\n.cols{display:grid;grid-template-columns:1fr 1fr;gap:24px}"
    ш = ш + "\n.form{display:grid;gap:14px;max-width:520px}"
    ш = ш + "\n.field{display:grid;gap:6px;font-size:14px;color:var(--muted)}"
    ш = ш + "\n.field input{padding:10px 12px;border:1px solid var(--line);border-radius:8px;font:inherit;color:var(--ink)}"
    ш = ш + "\nbutton{padding:11px 18px;border:0;border-radius:9px;background:var(--ink);color:#fff;font:inherit;cursor:pointer}"
    ш = ш + "\n.btn{display:inline-block;padding:11px 18px;border-radius:9px;background:var(--ink);color:#fff}"
    ш = ш + "\n.btn:hover{text-decoration:none;opacity:.9}"
    ш = ш + "\nimg{max-width:100%;height:auto;border-radius:10px}"
    ш = ш + "\n.foot{max-width:1000px;margin:48px auto 24px;padding:20px 24px;border-top:1px solid var(--line);color:var(--muted);font-size:14px}"
    ш = ш + "\n@media(max-width:720px){.cols{grid-template-columns:1fr}.head{flex-direction:column;align-items:flex-start}}"
    вернуть ш + "\n"

# ---------- страницы и сайт ----------

делать страница(заголовок_стр, тело, описание):
    пусть ш = "<!doctype html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n"
    ш = ш + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    ш = ш + "<title>" + экранировать(заголовок_стр) + "</title>\n"
    ш = ш + "<meta name=\"description\" content=\"" + экранировать(описание) + "\">\n"
    ш = ш + "<link rel=\"stylesheet\" href=\"style.css\">\n"
    ш = ш + "</head>\n<body>\n" + тело + "\n</body>\n</html>\n"
    вернуть ш

делать страница_простая(заголовок_стр, тело):
    вернуть страница(заголовок_стр, тело, заголовок_стр)

делать сохранить(путь, текст):
    записать(путь, текст)
    вернуть путь

делать сайт(папка, страницы):
    пусть готово = 0
    для стр в страницы:
        пусть файл = словарь_получить(стр, "файл")
        пусть ш = страница(словарь_получить(стр, "заголовок"), словарь_получить(стр, "тело"), словарь_получить(стр, "описание"))
        записать(папка + "/" + файл, ш)
        готово = готово + 1
    записать(папка + "/style.css", стили())
    вернуть готово

делать шаблон(текст, данные):
    пусть р = текст
    для к в словарь_ключи(данные):
        р = заменить(р, "{{" + к + "}}", "" + словарь_получить(данные, к))
    вернуть р

делать транслит(т):
    пусть р = нижний("" + т)
    пусть карта = словарь("а", "a", "б", "b", "в", "v", "г", "g", "д", "d", "е", "e", "ё", "e", "ж", "zh", "з", "z", "и", "i", "й", "y", "к", "k", "л", "l", "м", "m", "н", "n", "о", "o", "п", "p", "р", "r", "с", "s", "т", "t", "у", "u", "ф", "f", "х", "h", "ц", "c", "ч", "ch", "ш", "sh", "щ", "sch", "ъ", "", "ы", "y", "ь", "", "э", "e", "ю", "yu", "я", "ya")
    для к в словарь_ключи(карта):
        р = заменить(р, к, словарь_получить(карта, к))
    вернуть р

делать слаг(т):
    пусть р = транслит(т)
    пусть итог = ""
    пусть можно = "abcdefghijklmnopqrstuvwxyz0123456789"
    пусть инд = 0
    пока инд < длина(р):
        пусть сим = взять(р, инд)
        если найти(можно, сим) >= 0:
            итог = итог + сим
        иначе:
            если длина(итог) > 0:
                если взять(итог, длина(итог) - 1) != "-":
                    итог = итог + "-"
        инд = инд + 1
    если заканчивается_на(итог, "-"):
        итог = подстрока(итог, 0, длина(итог) - 1)
    вернуть итог
