# Тест 7: списки и строки
пусть числа = [10, 20, 30]
печатать("список:", числа)
печатать("длина списка:", длина(числа))

пусть слова = ["кот", "пёс"]
печатать("слова:", слова)

пусть пустой = []
печатать("пустой:", пустой)
печатать("его длина:", длина(пустой))

пусть строка = "Привет"
печатать("строка:", строка)
печатать("длина строки:", длина(строка))

печатать("склейка:", "Привет" + " " + "мир")
печатать("число и текст:", "возраст: " + 25)