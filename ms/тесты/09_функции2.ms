# Тест 9: новые встроенные функции

печатать("--- строки ---")
печатать(верхний("привет мир"))
печатать(нижний("ПРИВЕТ МИР"))
печатать(обрезать("   пробелы   "))
печатать(заменить("я люблю чай", "чай", "кофе"))
печатать(найти("привет мир", "мир"))
печатать(найти("привет", "з"))
печатать(разделить("яблоко,банан,груша", ","))
печатать(повторить("ай", 3))

печатать("--- математика ---")
печатать(корень(16))
печатать(модуль(-7))
печатать(округлить(3.6))
печатать(целое(3.9))

печатать("--- списки ---")
пусть числа = [5, 2, 9, 1]
печатать(сумма(числа))
печатать(среднее(числа))
печатать(минимум(числа))
печатать(максимум(числа))
печатать(сортировать(числа))
печатать(перевернуть(числа))
печатать(перевернуть("привет"))

печатать("--- по-русски ---")
печатать(прописью(0))
печатать(прописью(7))
печатать(прописью(21))
печатать(прописью(105))
печатать(прописью(1001))
печатать(прописью(1234567))

печатать("--- склонение ---")
печатать(1, склонение(1, "год", "года", "лет"))
печатать(2, склонение(2, "год", "года", "лет"))
печатать(5, склонение(5, "год", "года", "лет"))
печатать(11, склонение(11, "год", "года", "лет"))
печатать(21, склонение(21, "год", "года", "лет"))

печатать("--- файлы ---")
записать("проверка_ms.txt", "Привет из MS!")
печатать(существует("проверка_ms.txt"))
печатать(прочитать("проверка_ms.txt"))