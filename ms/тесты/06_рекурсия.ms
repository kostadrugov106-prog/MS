# Тест 6: рекурсия
делать факториал(н):
    если н <= 1:
        вернуть 1
    вернуть н * факториал(н - 1)

печатать("5! =", факториал(5))
печатать("10! =", факториал(10))

делать фибоначчи(н):
    если н < 2:
        вернуть н
    вернуть фибоначчи(н - 1) + фибоначчи(н - 2)

печатать("фиб(10) =", фибоначчи(10))

делать сумма_до(н):
    если н <= 0:
        вернуть 0
    вернуть н + сумма_до(н - 1)

печатать("сумма до 100 =", сумма_до(100))