# Тест 10: удобства языка
печатать "без скобок", 1 + 2
пусть х = 5
х += 3
х *= 2
печатать("х =", х)
печатать("строка # не комментарий")
печатать("перевод\nстроки")
печатать("а" * 3, "б" < "в", [1] + [2])
для н от 1 до 5:
    печатать(н)
для н от 5 до 1 шаг -2:
    печатать("назад", н)
пусть сумма = 0
для н от 1 до 100:
    сумма += н
печатать("сумма", сумма)
