# Тест 5: функции, параметры, возврат
делать удвой(число):
    вернуть число * 2

делать сумма(а, б):
    вернуть а + б

делать привет(имя):
    печатать("Привет,", имя, "!")

печатать(удвой(21))
печатать(сумма(3, 4))
привет("Аня")

делать без_возврата(х):
    пусть у = х + 1

печатать(без_возврата(5))