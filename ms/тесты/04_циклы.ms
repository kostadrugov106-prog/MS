# Тест 4: циклы
пусть i = 1
пусть сумма = 0
пока i <= 10:
    сумма = сумма + i
    i = i + 1
печатать("Сумма 1..10 =", сумма)

пусть n = 5
пусть факт = 1
пока n > 1:
    факт = факт * n
    n = n - 1
печатать("5! =", факт)

# цикл, который может не выполниться ни разу
пусть ж = 100
пока ж < 10:
    печатать("не должно быть")
печатать("конец цикла")