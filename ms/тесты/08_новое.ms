# Тест 8: новые удобные конструкции

# иначе если — цепочка
пусть оценка = 4

если оценка == 5:
    печатать("отлично")
иначе если оценка == 4:
    печатать("хорошо")
иначе если оценка == 3:
    печатать("удовлетворительно")
иначе:
    печатать("плохо")

# цикл для по списку
для число в [1, 2, 3]:
    печатать("число:", число)

# для по строке (по буквам)
для буква в "мир":
    печатать("буква:", буква)

# накопление через для
пусть сумма = 0
для н в [10, 20, 30]:
    сумма = сумма + н
печатать("сумма:", сумма)

# прервать
для н в [1, 2, 3, 4, 5]:
    если н == 3:
        прервать
    печатать("до прерыва:", н)

# продолжить
для н в [1, 2, 3, 4]:
    если н == 2:
        продолжить
    печатать("без двойки:", н)