# Тест 11: новые функции
печатать("срез:", срез("Привет", 1, 4), подстрока("Привет", -3, 6))
печатать("символ:", символ(1046), "код:", код("Ж"))
печатать("границы:", начинается_с("Привет", "При"), заканчивается_на("Привет", "вет"))
печатать("индекс:", индекс([10, 20, 30], 20), индекс("привет", "вет"))
пусть сп = [1, 3]
вставить(сп, 1, 2)
печатать("вставили:", сп)
удалить(сп, 0)
печатать("удалили:", сп)
очистить(сп)
печатать("очистили:", сп)
печатать("математика:", пи(), степень(2, 8), логарифм(100, 10), синус(0))
печатать("типы:", тип(1), тип("а"), тип([1]), тип(правда), тип(ничего))
печатать("дата есть:", длина(дата()) > 0, длина(сейчас()) > 0)
пусть путь = "тест_файл.txt"
записать(путь, "раз\nдва\nтри")
печатать("строки:", строки_файла(путь))
дописать(путь, "\nчетыре")
печатать("после дописать:", строки_файла(путь))
печатать("размер:", размер_файла(путь) > 0)
удалить_файл(путь)
печатать("удалён:", существует(путь) == ложь)
печатать("файлы — список:", тип(файлы(".")))
