# Тест 14: расширение «Веб»
подключить("веб")
печатать(экранировать("<b>Привет & ""мир""</b>"))
печатать(ссылка("MS", "https://mazing-studio.site"))
печатать(список(["раз", "два"]))
печатать(таблица(["а", "б"], [["1", "2"]]))
печатать(слаг("Привет мир!"))
печатать(шаблон("Здравствуйте, {{имя}}!", словарь("имя", "Аня")))