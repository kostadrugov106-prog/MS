# Тест 3: вложенные условия
пусть возраст = 15

если возраст >= 18:
    печатать("взрослый")
    если возраст >= 60:
        печатать("пенсионер")
    иначе:
        печатать("работающий")
иначе:
    печатать("ребёнок")
    если возраст >= 14:
        печатать("подросток")
    иначе:
        печатать("малыш")

если возраст > 100:
    печатать("долгожитель")