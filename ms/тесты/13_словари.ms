# Словари: создание, доступ, изменение и удаление
пусть д = словарь("а", 1, "б", 2)
печатать(д)
печатать(словарь_получить(д, "б"))
словарь_установить(д, "в", 3)
печатать(словарь_размер(д))
печатать(словарь_ключи(д))
печатать(словарь_есть(д, "а"))
словарь_удалить(д, "а")
печатать(словарь_размер(д))
печатать(словарь_получить(д, "нет"))
